# Public site URL used for canonical links, Open Graph, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
# Demo-request transport: "netlify-forms" (Netlify Forms; set in netlify.toml), "json" (POST to the endpoint below)
# or empty (form shows "not connected yet"; falls back to "json" when an endpoint is set).
NEXT_PUBLIC_DEMO_REQUEST_TRANSPORT=
# JSON receiver for demo requests (transport "json" only).
NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=
# Base URL of the core application (credigit-ser-frontend). Log in / Register buttons go to <url>/login and <url>/register.
# Leave empty until the app is deployed; the buttons then open placeholder pages on this site.
NEXT_PUBLIC_APP_URL=https://credigit-app.netlify.app
